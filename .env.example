# Copy to `.env` and fill in. This file is NOT committed (see .gitignore).
# These are example keys for local development against lab/prod FortiGates.

# FortiTUI API token for a direct profile (used when keyring is disabled).
# Alternatively store per-profile tokens in the OS keychain (feature: keyring).
FORTITUI_TOKEN=

# GitHub (for repo admin via gh / API) — optional, not used by FortiTUI.
# GH_TOKEN=

# Example direct-profile device endpoints (not used by the binary directly).
# FORTIGATE_DEV=       # test FortiGate
# FORTIGATE_PROD=      # prod FortiGate (data-generation only)
